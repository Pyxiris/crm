<odoo noupdate="1">
    <!-- Let salesmen see tasks linked to their personal or unassigned leads -->
    <record id="rule_salesman_own_lead_tasks" model="ir.rule">
        <field name="name">Tasks linked to my leads</field>
        <field name="model_id" ref="project.model_project_task" />
        <field name="domain_force">[
        '|',
            ('lead_id.user_id', '=', user.id),
            ('lead_id.user_id', '=', False)
        ]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
    </record>

    <!-- Let salesman with access to all leads see all tasks linked to those leads -->
    <record id="rule_salesman_all_lead_tasks" model="ir.rule">
        <field name="name">Tasks linked to any leads I have access to</field>
        <field name="model_id" ref="project.model_project_task" />
        <field name="domain_force">[
        '&amp;',
            ('lead_id', '!=', False),
            ('lead_id.company_id', 'in', company_ids + [False])
        ]</field>
        <field
            name="groups"
            eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"
        />
    </record>
</odoo>
